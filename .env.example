# Postgres. Sirve cualquiera: Supabase, Railway, Neon o uno local.
# Supabase → Project Settings → Database → Connection string → URI (usar el pooler, puerto 6543)
DATABASE_URL="postgresql://usuario:password@host:5432/postgres"

# Alternativa sin instalar nada, para una primera mirada (ver README):
# DATABASE_URL="pglite://./.pglite"

# Clave para firmar la cookie de sesión. Generar una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# Password inicial de los usuarios sembrados por `npm run db:seed`.
SEED_PASSWORD="boyer2026"
